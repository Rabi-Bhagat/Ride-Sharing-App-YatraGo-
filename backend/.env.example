# ==============================================================================
# YATRAGO BACKEND ENVIRONMENT CONFIGURATION (.env)
# Only these variables are read by the backend. Everything else is optional.
# ==============================================================================

# 1. CORE SERVER
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# 2. DATABASE (MongoDB Atlas or local). Leave blank to run on in-memory fallback.
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/yatrago?retryWrites=true&w=majority

# 3. AUTHENTICATION & SECURITY
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_random_key_here_min_32_chars
JWT_EXPIRES_IN=7d
ADMIN_ACCESS_KEY=YatraGo_Admin_MasterKey_2026

# 4. PAYMENTS - RAZORPAY (India / INR ₹). Omit to disable live checkout.
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretHere

# 5. TRANSACTIONAL EMAIL (welcome / OTP / password reset)
# Omit SMTP_USER + SMTP_PASS to simulate delivery in logs.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_account@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="YatraGo Mobility <your_account@gmail.com>"
