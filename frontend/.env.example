# ==============================================================================
# YATRAGO FRONTEND ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# 1. BACKEND API / SOCKET URL
# Leave blank in local dev (Vite proxies /api and /socket.io to :5000).
# Set to your deployed backend origin in production, e.g. https://api.yatrago.com
VITE_BACKEND_URL=

# 2. GOOGLE MAPS PLATFORM
VITE_GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHere

# 3. RAZORPAY PUBLIC KEY (checkout)
VITE_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere

# 4. ENVIRONMENT MODE
VITE_APP_ENV=development
